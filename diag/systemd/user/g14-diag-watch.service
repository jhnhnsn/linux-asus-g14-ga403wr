# Desktop notification + state snapshot the moment a GPU/kernel fault is logged.
[Unit]
Description=g14-diag: live GPU/kernel fault watcher
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/g14-diag watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
